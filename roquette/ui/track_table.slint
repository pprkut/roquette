import { ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export enum ItemStatus { new, unread, read }

export struct ItemRow {
    title: string,
    feed: string,
    author: string,
    date: string,
    status: ItemStatus,
    starred: bool,
}

// Widths of the columns after the title, which takes the rest.
struct ColumnWidths {
    feed: length,
    author: length,
    date: length,
}

component SortArrow inherits Path {
    in property <bool> ascending;

    width: 8px;
    height: 8px;
    viewbox-width: 8;
    viewbox-height: 8;
    commands: root.ascending ? "M 0.5 5.5 L 4 2 L 7.5 5.5" : "M 0.5 2.5 L 4 6 L 7.5 2.5";
    stroke-width: 1.2px;
    stroke: Palette.foreground;
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> ascending;
    callback clicked();

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.row-padding;
        padding-right: Theme.row-padding;
        spacing: 4px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            overflow: elide;
            vertical-alignment: center;
            color: Palette.foreground;
        }

        if root.sorted: SortArrow {
            y: (parent.height - self.height) / 2;
            ascending: root.ascending;
        }
    }
}

// Drag handle on the left edge of a column; dragging it to the left makes
// the column wider.
component ColumnResizer inherits Rectangle {
    in-out property <length> column-width;
    in property <length> min-column-width: 40px;
    in property <length> max-column-width: 1000px;

    width: 7px;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 4px;
        width: 1px;
        height: parent.height - 8px;
        background: Theme.separator;
    }

    touch := TouchArea {
        mouse-cursor: col-resize;
        // The handle moves with the width it changes, so the offset from
        // where it was grabbed is what remains to be applied.
        moved => {
            if self.pressed {
                root.column-width = clamp(root.column-width - (self.mouse-x - self.pressed-x), root.min-column-width, root.max-column-width);
            }
        }
    }
}

component ItemTableRow inherits Rectangle {
    in property <ItemRow> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> focused;
    in property <ColumnWidths> widths;
    // Two lines (title; feed, author and date) instead of table columns.
    in property <bool> compact;
    // Web pages can be opened in tabs (the `servo` feature).
    in property <bool> tabs-available;
    callback clicked();
    // An entry of the context menu was activated.
    callback menu(action: string);

    property <brush> text-color: root.entry.status == ItemStatus.new ? Theme.status-new : root.entry.status == ItemStatus.unread ? Theme.status-unread : Palette.foreground;

    height: root.compact ? Theme.compact-row-height : Theme.row-height;
    background: Math.mod(root.index, 2) == 1 ? Theme.alternate-row : transparent;

    Rectangle {
        x: 2px;
        width: parent.width - 4px;
        border-radius: Theme.selection-radius;
        background: root.selected ? Theme.selection(root.focused) : touch.has-hover ? Theme.hover : transparent;
        border-width: root.selected && root.focused ? 1px : 0px;
        border-color: Theme.selection-border;
    }

    menu-area := ContextMenuArea {
        Menu {
            if root.tabs-available: MenuItem {
                title: "Open Link in Tab";
                activated => {
                    root.menu("open-tab");
                }
            }
            MenuItem {
                title: "Open Link in External Browser";
                activated => {
                    root.menu("open-browser");
                }
            }
            MenuItem {
                title: "Copy Link Address";
                activated => {
                    root.menu("copy-link");
                }
            }
            MenuSeparator { }
            if root.entry.status != ItemStatus.read: MenuItem {
                title: "Mark as Read";
                activated => {
                    root.menu("mark-read");
                }
            }
            if root.entry.status == ItemStatus.read: MenuItem {
                title: "Mark as Unread";
                activated => {
                    root.menu("mark-unread");
                }
            }
            MenuItem {
                title: root.entry.starred ? "Remove Star" : "Star";
                activated => {
                    root.menu("toggle-star");
                }
            }
        }

        touch := TouchArea {
            clicked => {
                root.clicked();
            }
            // A right click selects the row before its menu opens, so the
            // menu is about the article shown. This TouchArea takes the
            // click before the ContextMenuArea sees it.
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.clicked();
                    menu-area.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }

    if root.compact: VerticalLayout {
        padding-left: Theme.row-padding + 2px;
        padding-right: Theme.row-padding + 2px;
        alignment: center;
        spacing: 2px;

        HorizontalLayout {
            spacing: 4px;

            if root.entry.starred: Text {
                text: "★";
                color: Theme.starred;
            }

            Text {
                horizontal-stretch: 1;
                text: root.entry.title;
                overflow: elide;
                font-weight: root.entry.status == ItemStatus.read ? 400 : 600;
                color: root.text-color;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: root.entry.author == "" ? root.entry.feed : "\{root.entry.feed} · \{root.entry.author}";
                overflow: elide;
                font-size: 0.85rem;
                color: Palette.foreground;
                opacity: 0.7;
            }

            Text {
                text: root.entry.date;
                font-size: 0.85rem;
                color: Palette.foreground;
                opacity: 0.7;
            }
        }
    }

    if !root.compact: HorizontalLayout {
        padding-left: Theme.row-padding;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            padding-right: Theme.row-padding;
            min-width: 0px;

            if root.entry.starred: Text {
                text: "★";
                vertical-alignment: center;
                color: Theme.starred;
            }

            Text {
                horizontal-stretch: 1;
                text: root.entry.title;
                overflow: elide;
                vertical-alignment: center;
                color: root.text-color;
            }
        }

        for cell in [
            { text: root.entry.feed, width: root.widths.feed },
            { text: root.entry.author, width: root.widths.author },
            { text: root.entry.date, width: root.widths.date },
        ]: HorizontalLayout {
            width: cell.width;
            // Resizer handle plus the header cell's padding.
            padding-left: 7px + Theme.row-padding;
            padding-right: Theme.row-padding;

            Text {
                text: cell.text;
                overflow: elide;
                vertical-alignment: center;
                color: root.text-color;
            }
        }
    }
}

// The items of the selected feed or folder: as a table with sortable,
// resizable columns, or in compact mode as a list of two-line rows. Rows come from a lazy model; sorting and keyboard
// navigation are handled by the view model.
export component ItemTable inherits FocusScope {
    in property <[ItemRow]> rows;
    in property <int> current: -1;
    // Column the list is sorted by: 0 title, 1 feed, 2 author, 3 date.
    in property <int> sort-column: 3;
    in property <bool> sort-ascending: false;
    in-out property <length> feed-width: 160px;
    in-out property <length> author-width: 140px;
    in-out property <length> date-width: 140px;
    // Two-line rows without a header, for a narrow list beside the article.
    in property <bool> compact;
    // Web pages can be opened in tabs (the `servo` feature).
    in property <bool> tabs-available;

    property <length> row-height: root.compact ? Theme.compact-row-height : Theme.row-height;

    // For the autoscroll measurement.
    in-out property <length> content-y <=> list.content-y;
    out property <length> scroll-range: max(0px, list.content-height - list.visible-height);

    callback select(row: int);
    callback sort(column: int);
    // A navigation key: "up", "down", "page-up", "page-down", "home" or
    // "end", and the number of rows per page.
    callback navigate(key: string, page: int);
    // An entry of a row's context menu was activated.
    callback menu(row: int, action: string);

    changed current => {
        // Keep the selected row in view.
        let top = root.current * root.row-height;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + root.row-height > -list.content-y + list.visible-height {
            list.content-y = -(top + root.row-height - list.visible-height);
        }
    }

    key-pressed(event) => {
        let page = floor(list.visible-height / root.row-height);
        if event.text == Key.UpArrow {
            root.navigate("up", page);
        } else if event.text == Key.DownArrow {
            root.navigate("down", page);
        } else if event.text == Key.PageUp {
            root.navigate("page-up", page);
        } else if event.text == Key.PageDown {
            root.navigate("page-down", page);
        } else if event.text == Key.Home {
            root.navigate("home", page);
        } else if event.text == Key.End {
            root.navigate("end", page);
        } else {
            return reject;
        }
        accept
    }

    VerticalLayout {
        if !root.compact: Rectangle {
            height: Theme.row-height;

            HorizontalLayout {
                padding-left: 0px;
                // The list's scroll bar sits below the header's right end.
                padding-right: 0px;

                HeaderCell {
                    horizontal-stretch: 1;
                    text: "Title";
                    sorted: root.sort-column == 0;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(0);
                    }
                }

                ColumnResizer {
                    column-width <=> root.feed-width;
                }

                HeaderCell {
                    width: root.feed-width - 7px;
                    text: "Feed";
                    sorted: root.sort-column == 1;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(1);
                    }
                }

                ColumnResizer {
                    column-width <=> root.author-width;
                }

                HeaderCell {
                    width: root.author-width - 7px;
                    text: "Author";
                    sorted: root.sort-column == 2;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(2);
                    }
                }

                ColumnResizer {
                    column-width <=> root.date-width;
                }

                HeaderCell {
                    width: root.date-width - 7px;
                    text: "Date";
                    sorted: root.sort-column == 3;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(3);
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }
        }

        list := ListView {
            for row[i] in root.rows: ItemTableRow {
                entry: row;
                index: i;
                selected: i == root.current;
                focused: root.has-focus;
                widths: { feed: root.feed-width, author: root.author-width, date: root.date-width };
                compact: root.compact;
                tabs-available: root.tabs-available;
                clicked => {
                    root.focus();
                    root.select(i);
                }
                menu(action) => {
                    root.menu(i, action);
                }
            }
        }
    }
}
