import { ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct TrackRow {
    number: string,
    title: string,
    artist: string,
    album: string,
    length: string,
}

// Widths of the columns other than the title, which takes the rest.
struct ColumnWidths {
    number: length,
    artist: length,
    album: length,
    length: length,
}

component SortArrow inherits Path {
    in property <bool> ascending;

    width: 8px;
    height: 8px;
    viewbox-width: 8;
    viewbox-height: 8;
    commands: root.ascending ? "M 0.5 5.5 L 4 2 L 7.5 5.5" : "M 0.5 2.5 L 4 6 L 7.5 2.5";
    stroke-width: 1.2px;
    stroke: Palette.foreground;
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <TextHorizontalAlignment> alignment: left;
    callback clicked();

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.row-padding;
        padding-right: Theme.row-padding;
        spacing: 4px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            overflow: elide;
            horizontal-alignment: root.alignment;
            vertical-alignment: center;
            color: Palette.foreground;
        }

        if root.sorted: SortArrow {
            y: (parent.height - self.height) / 2;
            ascending: root.ascending;
        }
    }
}

// Drag handle on the left edge of a column; dragging it to the left makes
// the column wider.
component ColumnResizer inherits Rectangle {
    in-out property <length> column-width;
    in property <length> min-column-width: 40px;
    in property <length> max-column-width: 1000px;

    width: 7px;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 4px;
        width: 1px;
        height: parent.height - 8px;
        background: Theme.separator;
    }

    touch := TouchArea {
        mouse-cursor: col-resize;
        // The handle moves with the width it changes, so the offset from
        // where it was grabbed is what remains to be applied.
        moved => {
            if self.pressed {
                root.column-width = clamp(root.column-width - (self.mouse-x - self.pressed-x), root.min-column-width, root.max-column-width);
            }
        }
    }
}

component Cell inherits HorizontalLayout {
    in property <string> text;
    in property <brush> color;
    in property <TextHorizontalAlignment> text-alignment: left;
    // Resizer handle plus the header cell's padding.
    padding-left: 7px + Theme.row-padding;
    padding-right: Theme.row-padding;

    Text {
        text: root.text;
        overflow: elide;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        color: root.color;
    }
}

component TrackTableRow inherits Rectangle {
    in property <TrackRow> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> focused;
    in property <ColumnWidths> widths;
    // What a drag from this row carries; asked for when a drag starts.
    in property <data-transfer> drag-data;
    callback clicked();
    callback double-clicked();
    // An entry of the context menu was activated.
    callback menu(action: string);

    height: Theme.row-height;
    background: Math.mod(root.index, 2) == 1 ? Theme.alternate-row : transparent;

    Rectangle {
        x: 2px;
        width: parent.width - 4px;
        border-radius: Theme.selection-radius;
        background: root.selected ? Theme.selection(root.focused) : touch.has-hover ? Theme.hover : transparent;
        border-width: root.selected && root.focused ? 1px : 0px;
        border-color: Theme.selection-border;
    }

    menu-area := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Append to Playlist";
                activated => {
                    root.menu("append");
                }
            }
            MenuItem {
                title: "Play Next";
                activated => {
                    root.menu("play-next");
                }
            }
        }

        DragArea {
            data: root.drag-data;
            allow-copy: true;

            touch := TouchArea {
                clicked => {
                    root.clicked();
                }
                double-clicked => {
                    root.double-clicked();
                }
                // A right click selects the row before its menu opens.
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.clicked();
                        menu-area.show({ x: self.mouse-x, y: self.mouse-y });
                    }
                }
            }
        }
    }

    HorizontalLayout {
        Cell {
            width: root.widths.number;
            padding-left: Theme.row-padding;
            text: root.entry.number;
            color: Palette.foreground;
            text-alignment: right;
        }

        Cell {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.entry.title;
            color: Palette.foreground;
        }

        Cell {
            width: root.widths.artist;
            text: root.entry.artist;
            color: Palette.foreground;
        }

        Cell {
            width: root.widths.album;
            text: root.entry.album;
            color: Palette.foreground;
        }

        Cell {
            width: root.widths.length;
            text: root.entry.length;
            color: Palette.foreground;
            text-alignment: right;
        }
    }
}

// Tracks as a table with sortable, resizable columns. Rows come from a
// lazy model; sorting and keyboard navigation are handled by the view
// model.
export component TrackTable inherits FocusScope {
    in property <[TrackRow]> rows;
    in property <int> current: -1;
    // Column the list is sorted by: 0 number (library order), 1 title,
    // 2 artist, 3 album, 4 length.
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;
    in property <length> number-width: 56px;
    in-out property <length> artist-width: 200px;
    in-out property <length> album-width: 220px;
    in-out property <length> length-width: 72px;

    // For the autoscroll measurement.
    in-out property <length> content-y <=> list.content-y;
    out property <length> scroll-range: max(0px, list.content-height - list.visible-height);

    callback select(row: int);
    callback activate(row: int);
    callback sort(column: int);
    // A navigation key: "up", "down", "page-up", "page-down", "home" or
    // "end", and the number of rows per page.
    callback navigate(key: string, page: int);
    // An entry of a row's context menu was activated.
    callback menu(row: int, action: string);
    // What dragging a row carries.
    pure callback drag-data(row: int) -> data-transfer;

    changed current => {
        // Keep the selected row in view.
        let top = root.current * Theme.row-height;
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + Theme.row-height > -list.content-y + list.visible-height {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    key-pressed(event) => {
        let page = floor(list.visible-height / Theme.row-height);
        if event.text == Key.UpArrow {
            root.navigate("up", page);
        } else if event.text == Key.DownArrow {
            root.navigate("down", page);
        } else if event.text == Key.PageUp {
            root.navigate("page-up", page);
        } else if event.text == Key.PageDown {
            root.navigate("page-down", page);
        } else if event.text == Key.Home {
            root.navigate("home", page);
        } else if event.text == Key.End {
            root.navigate("end", page);
        } else if event.text == Key.Return {
            root.activate(root.current);
        } else {
            return reject;
        }
        accept
    }

    VerticalLayout {
        Rectangle {
            height: Theme.row-height;

            HorizontalLayout {
                HeaderCell {
                    width: root.number-width;
                    text: "#";
                    alignment: right;
                    sorted: root.sort-column == 0;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(0);
                    }
                }

                HeaderCell {
                    horizontal-stretch: 1;
                    text: "Title";
                    sorted: root.sort-column == 1;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(1);
                    }
                }

                ColumnResizer {
                    column-width <=> root.artist-width;
                }

                HeaderCell {
                    width: root.artist-width - 7px;
                    text: "Artist";
                    sorted: root.sort-column == 2;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(2);
                    }
                }

                ColumnResizer {
                    column-width <=> root.album-width;
                }

                HeaderCell {
                    width: root.album-width - 7px;
                    text: "Album";
                    sorted: root.sort-column == 3;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(3);
                    }
                }

                ColumnResizer {
                    column-width <=> root.length-width;
                }

                HeaderCell {
                    width: root.length-width - 7px;
                    text: "Length";
                    alignment: right;
                    sorted: root.sort-column == 4;
                    ascending: root.sort-ascending;
                    clicked => {
                        root.sort(4);
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }
        }

        list := ListView {
            for row[i] in root.rows: TrackTableRow {
                entry: row;
                index: i;
                selected: i == root.current;
                focused: root.has-focus;
                widths: {
                    number: root.number-width,
                    artist: root.artist-width,
                    album: root.album-width,
                    length: root.length-width,
                };
                drag-data: root.drag-data(i);
                clicked => {
                    root.focus();
                    root.select(i);
                }
                double-clicked => {
                    root.activate(i);
                }
                menu(action) => {
                    root.menu(i, action);
                }
            }
        }
    }
}
